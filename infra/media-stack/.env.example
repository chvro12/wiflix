TZ=Europe/Paris

# `id -u` et `id -g` sur Linux/macOS.
PUID=501
PGID=20

JELLYFIN_PORT=8096
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
COMET_PORT=8000
SEERR_PORT=5055
VORTEX_PORT=6489

JELLYFIN_PUBLIC_URL=http://localhost:8096
VORTEX_LOG_LEVEL=info

# Ne jamais commiter la vraie valeur.
ALLDEBRID_RCLONE_API_KEY=
ALLDEBRID_VORTEX_API_KEY=
# Secours optionnel. Le compte doit être Premium.
REAL_DEBRID_API_KEY=
# Troisième fournisseur optionnel (offre Pro pour Usenet).
TORBOX_API_KEY=
# Indexeur Newznab utilisé pour découvrir les fichiers Usenet.
NZBFINDER_API_KEY=
JELLYFIN_ADMIN_USER=root
JELLYFIN_ADMIN_PASSWORD=

# Authentification interne des webhooks Radarr/Sonarr vers r2-importer.
R2_IMPORTER_USER=weflix
R2_IMPORTER_PASSWORD=
RADARR_API_KEY=
SONARR_API_KEY=
R2_SYNC_INTERVAL_HOURS=6
CATALOGUE_PRELOAD_ENABLED=true
CATALOGUE_PRELOAD_INTERVAL_SECONDS=300
CATALOGUE_PRELOAD_MAX_R2_PENDING=450
CATALOGUE_PRELOAD_MAX_PAGE=500
LIVE_READY_SEGMENTS=10
R2_PAUSE_AT_INTERACTIVE_STREAMS=2
