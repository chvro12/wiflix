# Catalogue et métadonnées TMDB (jamais les fichiers vidéo)
VITE_TMDB_API=
# Jeton Bearer v4 réservé au serveur : ne jamais ajouter le préfixe VITE_.
TMDB_READ_ACCESS_TOKEN=
VITE_BASE_URL=https://api.themoviedb.org/3

# URL publique définitive du site
VITE_SITE_URL=http://localhost:5173
VITE_SEERR_URL=http://localhost:5055

# Portail public /acces et page /admin. Ces valeurs restent côté serveur.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
REDIRECT_DESTINATION_URL=

# Passerelle locale Vite → Jellyfin. Ne jamais préfixer la clé par VITE_.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# Firebase Auth + Firestore (configuration cliente publique)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudflare Turnstile : la clé de site est publique, la clé secrète reste serveur.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_EDGE_API_URL=

# La configuration secrète du fournisseur vidéo ne doit PAS être placée
# dans une variable VITE_: tout préfixe VITE_ est exposé au navigateur.
# Ces valeurs seront utilisées par une API serveur à ajouter.
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY=

# Cloudflare R2 (serveur uniquement)
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=weflix-media
R2_ENDPOINT=
R2_S3_URL=
MEDIA_ORIGIN_PUBLIC_URL=https://origin.wiflix.site
MEDIA_ORIGIN_TOKEN=replace-with-a-long-random-secret
MEDIA_ORIGIN_SIGNING_KEY=replace-with-a-different-long-random-secret
CLOUDFLARE_TUNNEL_TOKEN=
